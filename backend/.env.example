# Backend API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Writable Academic Portal DB
ACADEMIC_DB_HOST=127.0.0.1
ACADEMIC_DB_PORT=3306
ACADEMIC_DB_USER=academic_app
ACADEMIC_DB_PASSWORD=change_me
ACADEMIC_DB_NAME=academic_portal

# Read-only Student Database
STUDENT_DB_HOST=
STUDENT_DB_PORT=3306
STUDENT_DB_USER=
STUDENT_DB_PASSWORD=
STUDENT_DB_NAME=student_database
STUDENT_DB_SSL=true

# Read-only Examination Portal
EXAM_DB_HOST=
EXAM_DB_PORT=3306
EXAM_DB_USER=
EXAM_DB_PASSWORD=
EXAM_DB_NAME=examination_portal
EXAM_DB_SSL=true

# Read-only HRMS Mongo
HRMS_MONGO_URL=

# Auth session (HTTP-only cookie; HRMS passwords never stored in AP)
AP_SESSION_COOKIE=ap_sid
AP_SESSION_TTL_HOURS=12
# Set true behind HTTPS in production (required when NODE_ENV=production)
AP_SESSION_SECURE=false

# Super Admin bootstrap password (required in production; optional in development)
# AP_SUPERADMIN_PASSWORD=
