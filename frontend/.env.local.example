# Frontend (Next.js)
NEXT_PUBLIC_APP_NAME=Pydah Academic Portal
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Login / portal branding (no DB required)
NEXT_PUBLIC_COLLEGE_NAME=Pydah Group of Institutions
NEXT_PUBLIC_PORTAL_NAME=ACADEMIC PORTAL
# Local path (/branding/...) or full https URL — institution logo (not the app icon)
NEXT_PUBLIC_COLLEGE_LOGO=/branding/college-logo.svg
# Pydah Academic Portal app / PWA icon (product branding)
# NEXT_PUBLIC_APP_ICON=/branding/pydah-academic-portal-icon.png
# NEXT_PUBLIC_APP_ICON_MARK=/branding/icon-mark.png
# Optional: back-arrow target on the login card
# NEXT_PUBLIC_COLLEGE_WEBSITE=https://example.edu
